<div class="page-heading"><div><span class="eyebrow">INSIGHTS · <%=formatDate(weekStart)%> — <%=formatDate(weekEnd)%></span><h1>Weekly analysis</h1><p class="muted">Understand your consistency and find where to focus next.</p></div></div>
<div class="stats-grid three-stats"><div class="stat-card"><div class="stat-icon">◎</div><span>Total goals</span><strong><%=totalGoals%></strong><small>this week</small></div><div class="stat-card"><div class="stat-icon green">✓</div><span>Completed</span><strong><%=completedGoals%></strong><small>this week</small></div><div class="stat-card accent"><div class="stat-icon purple">↗</div><span>Completion rate</span><strong><%=completionPct%>%</strong><small>weekly performance</small></div></div>
<div class="content-grid">
<section class="panel"><div class="panel-head"><div><h2>Daily progress</h2><p class="muted">Completed goals by day</p></div></div><div class="bar-chart"><%days.forEach(d=>{%><div class="bar-col"><span><%=d.completed%></span><div class="bar-track"><div class="bar-fill" style="height:<%=d.total?Math.max(6,d.pct):2%>%"></div></div><small><%=d.label%></small></div><%})%></div></section>
<section class="panel"><div class="panel-head"><div><h2>Overall completion</h2><p class="muted">This week's target</p></div></div><div class="big-percent"><%=completionPct%><small>%</small></div><div class="progress-track"><div style="width:<%=completionPct%>%"></div></div><p class="muted"><%=completedGoals%> of <%=totalGoals%> goals completed.</p></section>
</div>
<section class="panel"><div class="panel-head"><div><h2>Subject breakdown</h2><p class="muted">All your recorded goals</p></div></div>
<%if(subjectStats.length){%><div class="subject-list"><%subjectStats.forEach(s=>{const pct=s.total?Math.round(s.completed*100/s.total):0;%><div class="subject-row"><div><strong><%=s.subject%></strong><span><%=s.completed%>/<%=s.total%> completed</span></div><b><%=pct%>%</b><div class="progress-track"><div style="width:<%=pct%>%"></div></div></div><%})%></div><%}else{%><div class="empty-state"><h3>No data yet</h3><p>Create some goals to see your analysis.</p></div><%}%>
</section>
