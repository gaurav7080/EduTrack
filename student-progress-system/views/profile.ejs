<div class="page-heading"><div><span class="eyebrow">ACCOUNT</span><h1>Your profile</h1><p class="muted">Keep your academic details up to date.</p></div></div>
<section class="panel profile-panel"><div class="profile-hero"><span class="profile-avatar"><%=user.name.charAt(0).toUpperCase()%></span><div><h2><%=user.name%></h2><p><%=user.email%></p></div></div>
<form action="/profile/update" method="post" class="form"><div class="form-grid"><label>Full name <input name="name" value="<%=user.name%>" required></label><label>Email <input value="<%=user.email%>" disabled></label></div><div class="form-grid"><label>Course <input name="course" value="<%=user.course%>" required></label><label>Semester <input name="semester" value="<%=user.semester%>" required></label></div><div class="button-row"><button class="btn btn-primary">Save profile</button></div></form></section>
