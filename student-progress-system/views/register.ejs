<section class="auth-layout">
  <div class="auth-visual">
    <div class="auth-logo"><span class="brand-mark">SP</span> StudentProgress</div>
    <div>
      <span class="eyebrow">GET STARTED</span>
      <h1>Build a study system that <em>keeps you moving.</em></h1>
      <p>Create your personal academic workspace and start tracking your daily goals from day one.</p>
    </div>
    <div class="feature-row"><span>✓ Personal dashboard</span><span>✓ Secure login</span><span>✓ Weekly insights</span></div>
  </div>
  <div class="auth-panel">
    <div class="auth-card">
      <span class="eyebrow">CREATE ACCOUNT</span>
      <h2>Start your journey</h2>
      <p class="muted">It only takes a minute.</p>
      <form method="post" class="form">
        <label>Full name <input type="text" name="name" placeholder="Your name" autocomplete="name" maxlength="150" required></label>
        <label>Email <input type="email" name="email" placeholder="you@example.com" autocomplete="email" required></label>
        <div class="form-grid">
          <label>Course <input type="text" name="course" placeholder="B.Tech CSE" required></label>
          <label>Semester <input type="text" name="semester" placeholder="5th" required></label>
        </div>
        <label>Password <input id="password" type="password" name="password" placeholder="Minimum 6 characters" autocomplete="new-password" minlength="6" required></label>
        <div class="password-meter"><span id="passwordMeter"></span></div>
        <button class="btn btn-primary btn-full" type="submit">Create account <span>→</span></button>
      </form>
      <p class="auth-bottom">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </div>
</section>
