<div class="page-heading"><div><span class="eyebrow">GOALS</span><h1>Edit goal</h1><p class="muted">Update the plan without losing your progress.</p></div><a class="btn btn-secondary" href="/goals">← Back to goals</a></div>
<section class="panel form-panel">
<form method="post" class="form">
<label>Goal title <input type="text" name="title" value="<%=goal.title%>" required></label>
<label>Description <textarea name="description"><%=goal.description||''%></textarea></label>
<div class="form-grid"><label>Subject <input type="text" name="subject" value="<%=goal.subject||''%>"></label><label>Date <input type="date" name="goal_date" value="<%=String(goal.goal_date).slice(0,10)%>" required></label></div>
<label>Target study time (minutes) <input type="number" name="target_minutes" min="0" max="1440" value="<%=goal.target_minutes%>"></label>
<div class="button-row"><a class="btn btn-secondary" href="/goals">Cancel</a><button class="btn btn-primary">Save changes</button></div>
</form></section>
